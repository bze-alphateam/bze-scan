# Settings of the explorer UI, with their local values. Copy to .env.local
# (git-ignored) to change them. NEXT_PUBLIC_* values are inlined into the
# browser bundle at build time: changing one needs a new `pnpm build`.

# The backend API as the browser reaches it, without /v1 and without a
# trailing slash (production: https://scan.getbze.com/api).
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# The backend API as the Next.js server reaches it (page titles and
# descriptions); empty falls back to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:8080/api

# The chain the footer names.
NEXT_PUBLIC_CHAIN_ID=beezee-1

# The network badge in the header.
NEXT_PUBLIC_NETWORK_LABEL=Mainnet

# The BZE apps the explorer links to (the Apps menu, "Stake", "Trade",
# "Claim on Staking"...): the same network's hosts, without a trailing slash.
# Empty means mainnet; a testnet build points them at the testnet- hosts.
NEXT_PUBLIC_STAKING_URL=https://staking.getbze.com
NEXT_PUBLIC_DEX_URL=https://dex.getbze.com
NEXT_PUBLIC_BURNER_URL=https://burner.getbze.com
NEXT_PUBLIC_FACTORY_URL=https://factory.getbze.com
NEXT_PUBLIC_COMMUNITIES_URL=https://communities.getbze.com

# The "Ping.pub explorer" link (voting and anything the explorer does not show).
NEXT_PUBLIC_PINGPUB_URL=https://explorer.getbze.com/beezee

# The site's own URL: the base of its absolute links and previews.
NEXT_PUBLIC_SITE_URL=https://scan.getbze.com

# How long (ms) the transaction page keeps looking for a hash the API does
# not know yet before it says "not found". Empty means two minutes; the e2e
# build shortens it.
NEXT_PUBLIC_TX_PENDING_WINDOW_MS=
