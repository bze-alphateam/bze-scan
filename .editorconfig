root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Recorded node responses are stored byte for byte, as the node sent them.
[backend/internal/testutil/fakenode/testdata/**]
insert_final_newline = false
