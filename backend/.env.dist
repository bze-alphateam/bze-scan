# bze-scan backend configuration template. Copy to .env for local
# development; in production the variables come from the environment.
# Values here are the defaults, except DATABASE_URL, which has none.

# Listen address of the HTTP API (GET /health and, later, the explorer routes).
HTTP_ADDR=:8080

# Log level: trace, debug, info, warn, error, fatal or panic.
LOG_LEVEL=info

# Log format: text (human-readable) or json (one object per line).
LOG_FORMAT=text

# PostgreSQL URL of the node's database: the CometBFT psql sink schema plus the
# explorer schema created by `bze-scan migrate`. Required by every command that
# touches the database; no default. The value below is the development
# database of docker/compose.yml.
DATABASE_URL=postgres://bze:bze@localhost:15432/bze_index?sslmode=disable

# CometBFT RPC of the local node (the one whose psql sink writes into
# DATABASE_URL). The explorer calls /status, /block, /block_results and
# /commit by height, nothing else.
NODE_RPC_URL=http://127.0.0.1:26657

# The chain the node must serve: serve refuses to start the indexer when the
# node's /status reports another network.
CHAIN_ID=beezee-1

# Run the live indexer in serve. false runs the HTTP API only, the one way to
# run a second process against the same database.
INDEXER_ENABLED=true
