# bze-scan backend configuration template. Copy to .env for local
# development; in production the variables come from the environment.
# Values here are the defaults, except DATABASE_URL, which has none.

# Listen address of the HTTP API (GET /health and the /api/v1 routes).
HTTP_ADDR=:8080

# Origins allowed to call the API from a browser, comma-separated
# (https://explorer.getbze.com,http://localhost:3000), or * for any. Empty (the
# default) sends no CORS headers.
CORS_ALLOWED_ORIGINS=

# Log level: trace, debug, info, warn, error, fatal or panic.
LOG_LEVEL=info

# Log format: text (human-readable) or json (one object per line).
LOG_FORMAT=text

# PostgreSQL URL of the node's database: the CometBFT psql sink schema plus the
# explorer schema created by `bze-scan migrate`. Required by serve (the API
# reads it) and migrate; no default. The value below is the development
# database of docker/compose.yml.
DATABASE_URL=postgres://bze:bze@localhost:15432/bze_index?sslmode=disable

# CometBFT RPC of the local node (the one whose psql sink writes into
# DATABASE_URL). The explorer calls /status, /block, /block_results and
# /commit by height, nothing else.
NODE_RPC_URL=http://127.0.0.1:26657

# The chain the node must serve: serve refuses to start the indexer when the
# node's /status reports another network.
CHAIN_ID=beezee-1

# Run the live indexer and the state sync in serve. false runs the HTTP API
# only, the one way to run a second process against the same database.
INDEXER_ENABLED=true

# CometBFT RPC of an archive node, read by height only. The status checker
# (GET /api/v1/status) compares its tip with the local node's and the
# explorer's, the raw-JSON routes (/api/v1/raw/...) fetch the heights they have
# not cached from it, and the backfill and the catch-up read history from it.
# It must run CometBFT 0.38 (bze v8+): it serves pre-v8 heights in the layout
# the archive adapter expects (see README, "Old event formats").
ARCHIVE_RPC_URL=https://rpc.getbze.com

# Tried when ARCHIVE_RPC_URL fails. Empty (the default) means ARCHIVE_RPC_URL
# again.
ARCHIVE_RPC_RETRY_URL=

# How often the status checker reads the explorer's height and both nodes'
# tips (a Go duration: 60s, 1m, 500ms).
STATUS_INTERVAL=60s

# The largest spread, in blocks, between the explorer, the local node and the
# archive that still reports live_fill.healthy = true.
STATUS_HEIGHT_TOLERANCE=5

# Entries kept by each raw-JSON route's in-memory LRU (/block, /block_results
# and /commit bodies, one entry per height). The live indexer fills it with
# every height it writes.
RAW_CACHE_MAX_ENTRIES=300

# How long a raw-JSON entry lives after it was stored (a Go duration). By-height
# data never changes: expiry only bounds memory.
RAW_CACHE_TTL=20m

# The local node's gRPC server (host:port), queried by the state sync for
# validators and the other current-state tables. Never a public node.
NODE_GRPC_ADDR=127.0.0.1:9090

# Dial NODE_GRPC_ADDR with TLS (true/false).
NODE_GRPC_TLS=false

# Run the main backfill job inside serve: index history from the archive, from
# the live floor down to BACKFILL_FLOOR. The backfill command runs the same job
# standalone whatever this says. Turning it off pauses an unfinished job; it
# resumes from its checkpoint when turned on again.
BACKFILL_ENABLED=false

# The lowest height the backfill indexes: genesis, a height, or a YYYY-MM-DD
# date (the first block at or after that UTC midnight).
BACKFILL_FLOOR=genesis

# Heights fetched in parallel (X).
BACKFILL_WORKERS=10

# Heights written per flush (M), one database transaction each.
BACKFILL_BATCH=50

# Flush what the writer holds after this long without a new height (a Go
# duration).
BACKFILL_QUIET=2s

# Archive requests per second, across every worker of the backfill and the
# catch-up after a long outage. Three requests per height.
BACKFILL_RATE_LIMIT=20

# CoinGecko's API host. Its USD prices of COINGECKO_PRICE_IDS back the
# aggregator-compatible GET /api/prices (read at most every 180 s, the last
# read served up to 24 hours while CoinGecko fails) and the prices job.
COINGECKO_HOST=https://api.coingecko.com

# Comma-separated CoinGecko ids priced, in the order GET /api/prices lists
# them. Mainnet: bzedge,osmosis,cosmos.
COINGECKO_PRICE_IDS=bzedge

# Base URL of the BZE aggregator API, whose GET /api/dex/tickers gives BZE's
# 24-hour price change (see PRICE_CHANGE_MARKET). Empty (the default) leaves
# the change alone; the prices themselves come from CoinGecko. Production:
# https://getbze.com, where the aggregator serves /api.
AGGREGATOR_URL=

# The aggregator market whose /api/dex/tickers entry gives BZE's 24-hour price
# change, read at most every 5 minutes: mainnet's BZE/USDC.inj liquidity pool
# (USDC.inj priced in ubze), which replaced the halted USDC.n pool. Empty leaves
# the change null.
PRICE_CHANGE_MARKET=ibc/81DA528F4C5546208D1D50F84C2D0B388B45D37AA36FCA622A3CB2D8EF014838_ubze

# The Cosmos chain registry the chain_registry job caches daily (chain names,
# logos, explorers and IBC asset metadata): the GitHub contents API of the
# repository (directory listings, two calls a run, within GitHub's
# unauthenticated rate limit) and the base of its raw files.
CHAIN_REGISTRY_API_URL=https://api.github.com/repos/cosmos/chain-registry/contents
CHAIN_REGISTRY_RAW_URL=https://raw.githubusercontent.com/cosmos/chain-registry/master

# The Keybase user lookup the validators set reads validator logos from: a
# validator's description identity is a Keybase key suffix, its logo the
# user's primary picture (?key_suffix=<identity>&fields=pictures). Each
# validator is looked up at most once a day, or when its identity changes.
KEYBASE_URL=https://keybase.io/_/api/1.0/user/lookup.json

# The halt watch (with the state sync, INDEXER_ENABLED=true): while the chain
# is halted for a software upgrade it polls the local node's /consensus_state
# every HALT_WATCH_INTERVAL and records the validators voting again, the
# first poll that sees each. Display only (when each validator came back).
HALT_WATCH_ENABLED=true
HALT_WATCH_INTERVAL=5s

# How many heights after an upgrade the upgrade_recovery set reads commits
# (at BACKFILL_RATE_LIMIT) for the validators not back yet; a validator still
# missing by then has no back time.
UPGRADE_RECOVERY_WINDOW=10000

# Address (host:port) on which serve exposes the Go runtime profiles
# (net/http/pprof, under /debug/pprof/) for the soak and for debugging. Keep it
# on localhost, e.g. 127.0.0.1:6060: the profiles reveal the process's
# internals. Empty (the default) exposes nothing.
DEBUG_ADDR=
