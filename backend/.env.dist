# bze-scan backend configuration template. Copy to .env for local
# development; in production the variables come from the environment.
# Every variable has a default; values here are the defaults.

# Listen address of the HTTP API (GET /health and, later, the explorer routes).
HTTP_ADDR=:8080

# Log level: trace, debug, info, warn, error, fatal or panic.
LOG_LEVEL=info

# Log format: text (human-readable) or json (one object per line).
LOG_FORMAT=text
